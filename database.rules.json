{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$room": {
        "members": {
          ".read": "auth != null",
          "$member": {
            ".write": "auth != null && auth.uid == $member",
            ".validate": "newData.hasChildren(['char','name','x','y'])",
            "char": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "msg": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "msgAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "messages": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists()",
          "$msg": {
            ".write": "auth != null && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['uid','char','name','text','at'])",
            "uid": { ".validate": "newData.val() == auth.uid" },
            "char": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
